# NinjaTrader 8 TradingBot Configuration Template
# Copy these settings to your strategy parameters in NT8

# Indicator Settings
FastEMAPeriod=9
SlowEMAPeriod=21
ATRPeriod=14

# Risk Management Settings  
ATRMultiplier=2.0
RiskPerTradePercent=1.0
MaxDailyLoss=3.0

# Trading Hours (adjust for your timezone)
TradingStartTime=09:30:00
TradingEndTime=15:30:00

# Strategy Settings
AllowReversals=false

# Advanced Strategy Settings (NT8 Built-in)
Calculate=OnBarClose
EntriesPerDirection=1
EntryHandling=AllEntries
IsExitOnSessionCloseStrategy=true
ExitOnSessionCloseSeconds=30
MaximumBarsLookBack=TwoHundredFiftySix
OrderFillResolution=Standard
Slippage=0
StartBehavior=WaitUntilFlat
TimeInForce=Gtc
TraceOrders=false
RealtimeErrorHandling=StopCancelClose
StopTargetHandling=PerEntryExecution
BarsRequiredToTrade=20

# Market-Specific Presets

